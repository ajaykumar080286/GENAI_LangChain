    {
      "cell_type": "code",
      "source": [
        "import json\n",
        "\n",
        "for tool_call in tools:\n",
        "  if tool_call[\"name\"] == \"get_conversion_factor\":\n",
        "    total_msg = get_conversion_factor.invoke(tool_call)\n",
        "    messages.append(total_msg)\n",
        "    # Parse the JSON string content into a dictionary\n",
        "    data = json.loads(total_msg.content)\n",
        "    conversion_rate = data[\"conversion_rate\"]\n",
        "    #print(conversion_rate)\n",
        "\n",
        "  if tool_call[\"name\"] == \"convert\":\n",
        "    # Inject the retrieved conversion rate into the tool arguments\n",
        "    tool_call[\"args\"][\"conversion_rate\"] = conversion_rate\n",
        "    second_tool_result = convert.invoke(tool_call)\n",
        "    messages.append(second_tool_result)\n",
        "\n"
      ],
